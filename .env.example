# Story Protocol Configuration
NEXT_PUBLIC_STORY_RPC_URL=https://testnet.storyrpc.io
NEXT_PUBLIC_STORY_CHAIN_ID=1513

# CDR API Configuration
NEXT_PUBLIC_CDR_API_URL=https://cdr-api.story.foundation
CDR_API_KEY=your_cdr_api_key_here

# Wallet Connect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# OpenAI for AI Deal Assistant
OPENAI_API_KEY=your_openai_api_key_here

# Contract Addresses (Story Testnet)
NEXT_PUBLIC_DEALROOM_FACTORY_ADDRESS=
NEXT_PUBLIC_ESCROW_MANAGER_ADDRESS=
NEXT_PUBLIC_MULTISIG_CONTROLLER_ADDRESS=

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_ESCROW=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
