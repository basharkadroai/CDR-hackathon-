# Story Aeneid Testnet Configuration
NEXT_PUBLIC_STORY_RPC_URL=https://aeneid.storyrpc.io
NEXT_PUBLIC_CHAIN_ID=1315

# Story-API REST endpoint for CDR DKG state.
# This is plain HTTP, so the app proxies it through /api/cdr to avoid
# HTTPS->HTTP mixed-content blocking in production.
NEXT_PUBLIC_CDR_API_URL=http://172.192.41.96:1317

# CDR mode: false = REAL Confidential Data Rails, true = localStorage mock demo
NEXT_PUBLIC_USE_MOCK_CDR=false

# WalletConnect (optional, get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Deployed contract addresses (Story Aeneid Testnet)
NEXT_PUBLIC_DEALROOM_FACTORY_ADDRESS=
NEXT_PUBLIC_ESCROW_MANAGER_ADDRESS=
